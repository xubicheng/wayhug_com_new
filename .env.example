# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交
# 管理员口令（必填，>= 8 位）
ADMIN_PASSWORD=

# 站点
SITE_URL=https://wayhug.com
BIND=127.0.0.1
PORT=3005
COOKIE_SECURE=1
CONTACT_EMAIL=xubicheng@qq.com
DATABASE_URL=sqlite://data/wayhug.db

# SMTP（留空则不发送真实邮件，邮件写入 mail_outbox 并标记 logged）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_ENABLED=1
